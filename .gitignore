# Python cache
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# User-specific config (contains hardcoded local paths)
config.json

# Client list (real client PII — must never be committed)
client_list.txt
Client List.xlsx
*.client_list.txt

# Sample/working documents (may contain real client data)
sample_docs/

# Runtime markers
.deps_installed

# Generated reports (may contain client data)
Reports/

# PyInstaller build output
dist/
build/scandocs/
build/windows/Output/

# Build virtual environment
build/.venv/

# Tesseract installer binary (too large for git — download separately)
build/windows/Installers/*.exe

# Claude Code settings
.claude/

# Windows artifacts
Thumbs.db
Desktop.ini

# Benchmark data — REAL CLIENT DOCUMENTS, never commit
tools/benchmark_data/
tools/*.csv
benchmark_results*.csv

# Learning store — real corrected client names and document text excerpts,
# generated locally as the app is used. Never bundled, never committed.
corrections.jsonl
learning_index.json
renames.jsonl
.speedyscandocs.lock

# Locally-grown vocabularies — evolve per install, not repo assets
document_types.txt
providers.txt
