# Python cache
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# User-specific config (contains hardcoded local paths)
config.json

# Client list (real client PII — must never be committed)
client_list.txt
Client List.xlsx
*.client_list.txt

# Sample/working documents (may contain real client data)
sample_docs/

# Runtime markers
.deps_installed

# Generated reports (may contain client data)
Reports/

# PyInstaller build output
dist/
build/scandocs/
build/windows/Output/

# Build virtual environment
build/.venv/

# Tesseract installer binary (too large for git — download separately)
build/windows/Installers/*.exe

# Claude Code settings
.claude/

# Windows artifacts
Thumbs.db
Desktop.ini
